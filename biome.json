{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 2097152,
    "includes": [
      "**",
      "!!.next",
      "!!out",
      "!!build",
      "!!dist",
      "!!coverage",
      "!!.vercel",
      "!!.output",
      "!!.swc",
      "!!playwright-report",
      "!!test-results",
      "!!public",
      "!!wiki/.wiki-system",
      "!!next-env.d.ts",
      "!!package-lock.json",
      "!!src/app/contact/utils/email.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended",
      "next": "recommended",
      "react": "recommended",
      "playwright": "recommended",
      "tailwind": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnresolvedImports": "error",
        "noUndeclaredVariables": "error",
        "noUnusedInstantiation": "error",
        "useJsonImportAttributes": "error",
        "useSingleJsDocAsterisk": "error",
        "noProcessGlobal": "error",
        "noComponentHookFactories": "info"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 21
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "info",
          "options": {
            "maxLines": 300
          }
        },
        "noExcessiveNestedTestSuites": "error",
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useMaxParams": {
          "level": "warn",
          "options": {
            "max": 6
          }
        },
        "noExcessiveNestedCallbacks": "error",
        "noUnnecessaryTemplateExpression": "error",
        "useArraySome": "error",
        "useMathMinMax": "error",
        "useRegexpTest": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noEnum": "error",
        "noMultiAssign": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useDefaultParameterLast": "error",
        "useErrorCause": "error",
        "useGlobalThis": "error",
        "useNodeAssertStrict": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "on",
          "options": {
            "maxLines": 1000
          }
        },
        "useImportsFirst": "error",
        "useReduceTypeParameter": "error",
        "useUnicodeRegex": "error"
      },
      "performance": {
        "noAwaitInLoops": "warn",
        "noBarrelFile": "error",
        "noDelete": "warn",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "nursery": {
        "preset": "recommended",
        "noFloatingPromises": "error",
        "noBaseToString": "error",
        "noBunModules": "error",
        "noExtendNative": "error",
        "noImpliedEval": "error",
        "noMisleadingReturnType": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noReturnInFinally": "error",
        "noRestrictedDependencies": "warn",
        "noThisOutsideOfClass": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "noXorAsExponentiation": "error",
        "useAwaitThenable": "error",
        "useConsistentFunctionStyle": {
          "level": "on",
          "options": {
            "style": "declaration",
            "allowArrowFunctions": true
          }
        },
        "useExhaustiveSwitchCases": "error",
        "useIncludes": "error",
        "useModernMathApis": "error",
        "useNullishCoalescing": {
          "level": "info",
          "fix": "none"
        },
        "useRegexpExec": "error",
        "useStringStartsEndsWith": "error",
        "useTailwindShorthandClasses": "info",
        "useTailwindSortedClasses": {
          "level": "on"
        }
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error",
        "noEmptyBlockStatements": "on",
        "noConstantBinaryExpressions": "on",
        "noEvolvingTypes": "error",
        "noNestedPromises": "info",
        "noReturnAssign": "info",
        "noShadow": "error",
        "noUnassignedVariables": "error",
        "noUnnecessaryConditions": "info",
        "noUnusedExpressions": "error",
        "useArraySortCompare": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "noEmptySource": {
          "level": "on",
          "options": {
            "allowComments": true
          }
        },
        "noIdenticalTestTitle": "error",
        "noLoopFunc": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedPackageJson": "on",
        "noDuplicateClasses": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "e2e/**", "**/*.config.{ts,js,mjs}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "useMaxParams": "off"
          },
          "nursery": {
            "noUnsafeTypeAssertion": "off"
          },
          "suspicious": {
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/contact/action.ts", "src/app/contact/email-transporter.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["warn", "error"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/design-preview/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useValidAnchor": "off"
          }
        }
      }
    }
  ],
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["clsx", "tw"],
    "variantFunctions": ["cva"]
  }
}

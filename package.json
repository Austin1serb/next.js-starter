{
  "name": "next.js-starter",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "zero-icons",
    "build": "next build",
    "clean": "rm -rf .next node_modules",
    "dev": "rm -rf .next && next dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:classes": "biome lint --write --unsafe --only=nursery/useSortedClasses .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "start": "next start",
    "test": "playwright test",
    "test:install": "playwright install --with-deps",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@react-zero-ui/core": "^0.4.3",
    "@react-zero-ui/icon-sprite": "^0.4.1",
    "clsx": "^2.1.1",
    "motion": "^12.42.0",
    "next": "^16.2.11",
    "nodemailer": "^9.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "schema-dts": "^2.0.0",
    "typescript": "^5.9.3"
  }
}

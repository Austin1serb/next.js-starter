{
  "name": "next.js-starter",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "zero-icons",
    "build": "next build",
    "clean": "rm -rf .next node_modules",
    "dev": "rm -rf .next && next dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:classes": "biome lint --write --unsafe --only=nursery/useSortedClasses .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "start": "next start",
    "test": "playwright test",
    "test:install": "playwright install --with-deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@react-zero-ui/icon-sprite": "^0.4.1",
    "clsx": "^2.1.1",
    "motion": "^13.4.1",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "schema-dts": "^2.0.0",
    "typescript": "^7.0.2"
  }
}


NODE_ENV=development

SMTP_USER=owner@serbyte.net
SMTP_PASSWORD="..."

# Optional: Turnstile is enabled only when BOTH keys are set.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# For local testing, use Cloudflare's public, always-passing pair:
# NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional hostname allowlist; defaults to the hostname in DOMAIN_URL.
# TURNSTILE_HOSTNAMES=example.com,www.example.com
